# Backend environment variables
# Copy to backend/.env and fill in your values.

# Server port (Render sets PORT automatically)
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/grand-royal?retryWrites=true&w=majority

# Allowed frontend origin(s) for CORS
# Use a comma-separated list for multiple domains.
# Example production value:
# CLIENT_URL=https://your-app.vercel.app,https://www.your-domain.com
CLIENT_URL=http://localhost:3000

# Optional environment label
NODE_ENV=development
